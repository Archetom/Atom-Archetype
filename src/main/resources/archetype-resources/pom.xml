#set( $symbol_dollar = '$' )
#set( $symbol_pound = '#' )
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <packaging>pom</packaging>
    <version>${version}</version>
    <name>${rootArtifactId}</name>
    <description>${rootArtifactId}: Java 27 and Spring Boot 4.2 application with Domain-Driven Design boundaries</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>api</module>
        <module>domain</module>
        <module>shared</module>
        <module>application</module>
        <module>infra/external</module>
        <module>infra/security</module>
        <module>infra/persistence</module>
        <module>infra/rest</module>
        <module>infra/facade</module>
        <module>infra/grpc</module>
        <module>start</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <maven.minimum.version>3.10.0</maven.minimum.version>
        <project.build.outputTimestamp>2026-07-10T00:00:00Z</project.build.outputTimestamp>

        <!-- Common -->
        <atom.common.version>1.2.0</atom.common.version>

        <!-- Maven plugins newer than the Spring Boot defaults. -->
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <versions-maven-plugin.version>2.25.2</versions-maven-plugin.version>

        <!-- Third-party releases newer than the Spring Boot BOM. Keep each library family aligned. -->
        <commons-lang3.version>3.22.0</commons-lang3.version>
        <grpc-java.version>1.85.1</grpc-java.version>
        <jackson-bom.version>3.3.0</jackson-bom.version>
        <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
        <logback.version>1.6.8</logback.version>
        <lettuce.version>7.9.0.RELEASE</lettuce.version>
        <gson.version>2.15.0</gson.version>

        <!-- Database -->
        <flyway.version>13.13.0</flyway.version>
        <!-- Keep MyBatis at the version supplied by MyBatis-Plus: 3.6.0 removes APIs it still calls. -->
        <mybatis.plus.version>3.5.18.1</mybatis.plus.version>

        <!-- MapStruct -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>

        <!-- Architecture tests -->
        <archunit.version>1.5.1</archunit.version>

        <!-- SpringDoc -->
        <springdoc.version>3.2.1</springdoc.version>

        <!-- Google libraries shared by atom-common, grpc-java, and protobuf; pinned for dependency convergence. -->
        <guava.version>33.8.0-jre</guava.version>
        <error-prone-annotations.version>2.53.0</error-prone-annotations.version>
    </properties>

    <!-- The root POM owns dependency versions; each module declares what it uses directly. -->
    <dependencyManagement>
        <dependencies>
            <!-- Common -->
            <dependency>
                <groupId>io.github.archetom</groupId>
                <artifactId>atom-common</artifactId>
                <version>${symbol_dollar}{atom.common.version}</version>
            </dependency>
            <!-- MapStruct -->
            <!-- https://mvnrepository.com/artifact/org.mapstruct/mapstruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${symbol_dollar}{mapstruct.version}</version>
            </dependency>

            <!-- Database -->
            <!-- https://mvnrepository.com/artifact/com.baomidou/mybatis-plus-spring-boot4-starter -->
            <!-- https://github.com/baomidou/mybatis-plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${symbol_dollar}{mybatis.plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${symbol_dollar}{mybatis.plus.version}</version>
            </dependency>
            <!-- SpringDoc -->
            <!-- https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-starter-webmvc-ui -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${symbol_dollar}{springdoc.version}</version>
            </dependency>

            <!-- Converged Google libraries; keep at or above the versions grpc-java and atom-common require. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${symbol_dollar}{guava.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${symbol_dollar}{error-prone-annotations.version}</version>
            </dependency>

            <!-- Project Modules -->
            <!-- Public API contracts -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-api</artifactId>
                <version>${version}</version>
            </dependency>
            <!-- Framework-neutral domain model -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-domain</artifactId>
                <version>${version}</version>
            </dependency>
            <!-- Application use cases -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-application</artifactId>
                <version>${version}</version>
            </dependency>
            <!-- Infrastructure adapters -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-external</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-security</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-persistence</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-rest</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-facade</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-infra-grpc</artifactId>
                <version>${version}</version>
            </dependency>
            <!-- Shared result and error contracts -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>${rootArtifactId}-shared</artifactId>
                <version>${version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- Only start is runnable and sets this to false, so
                             `-pl start -am spring-boot:run` can build its upstream modules. -->
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${symbol_dollar}{lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${symbol_dollar}{lombok.mapstruct.binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${symbol_dollar}{mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <configuration>
                        <attach>true</attach>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>enforce-versions</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <dependencyConvergence/>
                                    <requireJavaVersion>
                                        <version>[${symbol_dollar}{java.version},)</version>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[${symbol_dollar}{maven.minimum.version},)</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
